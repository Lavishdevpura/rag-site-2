# ─────────────────────────────────────────────────────────────────────────────
# RAG Assistant — environment variables
# Copy this file to .env and fill in the values before running docker compose.
# NEVER commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM backend (vLLM) ───────────────────────────────────────────────────────
# URL of your vLLM server (no trailing slash).
# Example: http://your-server-ip:8000
VLLM_HOST=http://your-vllm-host:8000

# Model name as registered in vLLM (must match --served-model-name).
# Example: Qwen/Qwen2.5-7B-Instruct
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# API key for vLLM (leave blank if your server has no auth).
VLLM_API_KEY=

# Max tokens the LLM generates per response.
VLLM_MAX_TOKENS=1024


# ── Admin credentials ────────────────────────────────────────────────────────
# Username shown on the admin login page.
ADMIN_USERNAME=admin

# Password for the admin panel.
ADMIN_PASSWORD=change-me

# TEMPORARY: admin login is currently OFF BY DEFAULT (unset = disabled)
# so the app works with zero .env setup during early testing. Anyone who can
# reach the server can upload/delete documents and clear the cache with no
# password. Set this to false explicitly before real users can reach this
# deployment.
DISABLE_AUTH=true


# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens — generate a strong random string.
# Example: openssl rand -hex 32
AUTH_SECRET_KEY=change-me-use-a-long-random-string

# How long login sessions last (minutes). Default: 480 (8 hours).
AUTH_TOKEN_EXPIRE_MINUTES=480


# ── Metadata filtering ───────────────────────────────────────────────────────
# Off by default for this deployment — the document set/domain isn't known
# yet, so query-time category filtering stays disabled until it is. See
# metadata_tagger.py's ENABLE_METADATA_FILTERING for what this gates.
ENABLE_METADATA_FILTERING=false


# ── Natural-language-to-SQL (sql_rag/) ─────────────────────────────────────────
# Off by default. Lets the chatbot answer live-data questions ("status of
# X", "total revenue this month") by generating and running a read-only
# SQL query against a real relational database — a separate capability
# from document RAG, see sql_rag/pipeline.py. Both of these must be set
# for it to activate; either one missing/false keeps it a full no-op.
ENABLE_SQL_RAG=false

# SQLAlchemy connection string for the target database, e.g.:
#   mysql+pymysql://user:pass@host:3306/dbname
#   postgresql+psycopg2://user:pass@host:5432/dbname
# STRONGLY RECOMMENDED: use a database user with SELECT-only grants — this
# code enforces read-only at the application layer (sql_rag/validators.py),
# but a DB-level read-only credential is a second, independent safety net
# in case a bug upstream ever lets something else through.
SQL_DATABASE_URL=

# sqlglot dialect for SQL parsing — auto-derived from SQL_DATABASE_URL's
# scheme (mysql/postgres/sqlite/mssql); only set this to override that.
# SQL_DIALECT=

# Row cap on any query result (chat-answer safety backstop, not a feature).
SQL_MAX_RESULT_ROWS=200


# ── Embedding model ──────────────────────────────────────────────────────────
# Sentence-transformer model used for vector embeddings and semantic search.
# Change only if you want a different embedding model (requires re-ingesting all docs).
EMBED_MODEL=BAAI/bge-base-en-v1.5


# ── Vector store collection names ────────────────────────────────────────────
# Chroma collection names — only change if you need multiple isolated deployments.
TVEC_DOCS_COLLECTION=rag_docs
TVEC_SUMMARIES_COLLECTION=rag_summaries
TVEC_VIDEOS_COLLECTION=rag_videos
TVEC_WEBPAGES_COLLECTION=rag_webpages


# ── KV answer cache ──────────────────────────────────────────────────────────
# How long cached answers are valid (seconds). Default: 3600 (1 hour).
KV_CACHE_TTL=3600

# Maximum number of cached entries before LRU eviction kicks in.
KV_CACHE_MAX_ENTRIES=500

# Cosine similarity threshold for semantic cache hits (0–1). Default: 0.92.
SEMANTIC_CACHE_THRESHOLD=0.92


# ── Retrieval tuning ─────────────────────────────────────────────────────────
# BGE reranker score gate — queries whose best chunk scores below this are
# refused without calling the LLM. Scores are sigmoid-bounded probabilities
# in [0,1], but measured to NOT reliably separate good from bad content —
# legitimate questions can score quite low, below actual weak matches. Keep
# this near-zero (backstop against pure noise only); real grounding defense
# is the content-based coverage checks, not this score. Default: 0.0005.
RERANK_GATE_THRESHOLD=0.0005


# ── Optional: alternative LLM backends ──────────────────────────────────────
# Uncomment and fill in if you want to use OpenAI or Anthropic instead of vLLM.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Optional: Groq ────────────────────────────────────────────────────────────
# GROQ_API_KEY, once set, powers classification (metadata_tagger.py's
# ingestion tagging + multi_source_rag.py's query-time classification/
# extraction calls, see router.py's get_classification_llm()) — independent
# of FORCE_BACKEND below. Main RAG-answer generation stays on vLLM unless
# FORCE_BACKEND=groq is explicitly set (opt-in test only) — unset it (or set
# it to anything else) and vLLM is active again immediately, VLLM_HOST/
# VLLM_MODEL untouched either way.
#
# GROQ_MODEL/GROQ_CLASSIFICATION_MODEL default to openai/gpt-oss-120b, a
# REASONING model — needs reasoning_effort set and enough max_tokens
# headroom for reasoning tokens on top of the actual output (both handled
# automatically in code, nothing to configure beyond
# GROQ_CLASSIFICATION_REASONING_EFFORT below if you want a different effort
# level).
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# FORCE_BACKEND=groq
# GROQ_CLASSIFICATION_MODEL=openai/gpt-oss-120b
# GROQ_CLASSIFICATION_REASONING_EFFORT=low
